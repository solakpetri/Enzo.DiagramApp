{
  "Enzo": {
    "ApiKey": "YOUR_LOCAL_API_KEY",
    "RenderResults": {
      "Store": "Local",
      "UrlLifetimeMinutes": 30
    },
    "Limits": {
      "MaxRequestBodyBytes": 65536,
      "MaxSourceCharacters": 32768,
      "MaxSourceLines": 1000,
      "MaxDiagramElements": 500,
      "MaxDiagramConnections": 1000,
      "MaxPngWidth": 8000,
      "MaxPngHeight": 8000,
      "MaxPngPixels": 16000000
    }
  }
}
